<resources>

    
    <style name="Theme.ModuleLapTrinh" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/programming_white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_light</item>
        <item name="colorOnSecondary">@color/programming_black</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
    <item name="colorSurface">@color/bg_secondary</item><item name="colorOnSurface">@color/text_primary</item><item name="android:navigationBarColor">@color/bg_secondary</item><item name="android:fontFamily">sans-serif</item><item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item><item name="materialButtonStyle">@style/MentorProgrammingButton</item><item name="textInputStyle">@style/MentorProgrammingInput</item><item name="android:windowAnimationStyle">@style/MentorWindowAnimation</item></style>

    
    <style name="FullScreenDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
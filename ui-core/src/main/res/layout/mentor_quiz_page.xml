<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mentor_quiz_background">
    <Button android:id="@+id/mentor_quiz_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/mentor_quiz_done" android:textAllCaps="false" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/mentor_quiz_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mentor_quiz_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/mentor_quiz_text" />
            <com.example.mentor.ui.QuizSetupView android:id="@+id/mentor_quiz_setup" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mentor_quiz_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/mentor_quiz_secondary" android:accessibilityLiveRegion="polite" />
            <com.example.mentor.ui.QuizFormView android:id="@+id/mentor_quiz_form" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

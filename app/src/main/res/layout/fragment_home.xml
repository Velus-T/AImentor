<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/neumorphic_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">


        <TextView android:id="@+id/tv_home_welcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_welcome_back" android:textColor="@color/textColorSecondary" android:textSize="16sp" />

        <TextView android:id="@+id/txt_home_content" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_default_user" android:textColor="@color/textColorPrimary" android:textSize="24sp" android:textStyle="bold" />


        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/backgroundColor">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ux_start_title" android:textColor="@color/textColorPrimary" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/text_learning_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ux_start_hint" android:textColor="@color/textColorSecondary" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/button_start_learning" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/ux_choose_subject" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tv_dashboard_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/dashboard_partial" android:textColor="@color/textColorSecondary" android:textSize="14sp" android:visibility="gone" android:clickable="true" android:focusable="true" /><androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/neumorphic_card_bg" android:orientation="vertical" android:padding="20dp">

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:id="@+id/tv_total_level_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_overall_level" android:textColor="@color/textColorSecondary" android:textSize="14sp" android:layout_toStartOf="@id/tv_total_level_value" android:layout_marginEnd="8dp" />

                    <TextView android:id="@+id/tv_total_level_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="@string/home_default_level" android:textColor="@color/neumorphic_accent" android:textSize="16sp" android:textStyle="bold" />
                </RelativeLayout>

                <TextView android:id="@+id/tv_level_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_level_1" android:textColor="@color/textColorPrimary" android:textSize="20sp" android:textStyle="bold" />

                <ProgressBar android:id="@+id/pb_total_exp" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="16dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/custom_progress_bar" />

                <TextView android:id="@+id/tv_exp_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="8dp" android:text="@string/home_default_exp_remaining" android:textColor="@color/textColorSecondary" android:textSize="12sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <com.google.android.material.button.MaterialButton android:id="@+id/button_stats_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/ux_show_stats" style="@style/Widget.Material3.Button.TextButton" />
        <LinearLayout android:id="@+id/layout_detailed_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.example.mentor.ui.AdaptiveCardRow android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:baselineAligned="false" android:orientation="horizontal">


            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:layout_marginEnd="8dp" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/neumorphic_card_bg" android:gravity="center" android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_completion_ratio" android:textColor="@color/textColorPrimary" android:textSize="14sp" android:textStyle="bold" />

                    <com.example.asm_final.utils.SimplePieChartView android:id="@+id/pie_chart_exp" android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="12dp" />

                    <TextView android:id="@+id/tv_chart_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_based_on_exp" android:textColor="@color/textColorSecondary" android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/neumorphic_card_bg" android:orientation="vertical" android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_learning_time" android:textColor="@color/textColorPrimary" android:textSize="14sp" android:textStyle="bold" />


                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_math" android:textSize="12sp" android:layout_marginTop="12dp" />
                    <ProgressBar android:id="@+id/pb_time_math" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/custom_progress_bar" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_science" android:textSize="12sp" android:layout_marginTop="6dp" />
                    <ProgressBar android:id="@+id/pb_time_science" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/custom_progress_bar" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_history" android:textSize="12sp" android:layout_marginTop="6dp" />
                    <ProgressBar android:id="@+id/pb_time_history" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/custom_progress_bar" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cat_it" android:textSize="12sp" android:layout_marginTop="6dp" />
                    <ProgressBar android:id="@+id/pb_time_prog" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/custom_progress_bar" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </com.example.mentor.ui.AdaptiveCardRow>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/home_subject_progress" android:textColor="@color/textColorPrimary" android:textSize="18sp" android:textStyle="bold" />

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                <include layout="@layout/item_subject_mini_stat" android:id="@+id/mini_math" />
                <include layout="@layout/item_subject_mini_stat" android:id="@+id/mini_science" />
                <include layout="@layout/item_subject_mini_stat" android:id="@+id/mini_history" />
                <include layout="@layout/item_subject_mini_stat" android:id="@+id/mini_prog" />
            </LinearLayout>
        </HorizontalScrollView>



        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/home_recent_activity" android:textColor="@color/textColorPrimary" android:textSize="18sp" android:textStyle="bold" />

        <TextView android:id="@+id/text_recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/ux_no_activity" android:textColor="@color/textColorSecondary" android:textSize="14sp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_recent_activity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

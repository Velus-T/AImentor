<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/ui_background" android:clipToPadding="false">
    <com.example.aimentor.ui.ResponsiveColumn android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_gutter">
        <TextView style="@style/UiTitle" android:text="New category" />
        <TextView style="@style/UiBody" android:text="Give your learning a place to grow." />
        <TextView style="@style/UiBody" android:text="Category name" android:labelFor="@id/edtCategoryName" />
        <EditText style="@style/UiField" android:id="@+id/edtCategoryName" android:inputType="text" android:hint="Category name" android:autofillHints="" android:imeOptions="actionNext" />
        <TextView style="@style/UiBody" android:text="Description" android:labelFor="@id/edtDescription" />
        <EditText style="@style/UiField" android:id="@+id/edtDescription" android:inputType="textCapSentences|textMultiLine" android:hint="Description" android:autofillHints="" android:imeOptions="actionNext" />
        <Button style="@style/UiButton" android:id="@+id/btnSaveCategory" android:text="Save category" />
        <Button style="@style/UiButton" android:id="@+id/btnBackCategory" android:text="Back" />
    </com.example.aimentor.ui.ResponsiveColumn>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScienceSettingsBack"
                style="@style/ScienceSecondaryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:minWidth="48dp"
                android:padding="0dp"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Science settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini connection"
                android:textSize="18sp" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="The API key is encrypted with Android Keystore and used only by Science chat, quiz and study planning." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/science_option_background"
                android:minHeight="48dp"
                android:padding="12dp"
                android:text="Coursework/demo note: encryption protects the saved key on this device, but a production app should call Gemini through a secured backend and use a restricted API key."
                android:textColor="@color/science_text_primary"
                android:textSize="14sp" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="API key" />

            <EditText
                android:id="@+id/etScienceApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/science_field_background"
                android:hint="Paste Gemini API key"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="52dp"
                android:textColor="@color/science_text_primary"
                android:textColorHint="@color/science_text_secondary" />

            <CheckBox
                android:id="@+id/cbShowScienceApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/science_control_tint"
                android:minHeight="48dp"
                android:text="Show API key while editing"
                android:textColor="@color/science_text_primary" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Model" />

            <EditText
                android:id="@+id/etScienceModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/science_field_background"
                android:hint="gemini-3.5-flash"
                android:inputType="textNoSuggestions"
                android:minHeight="52dp"
                android:textColor="@color/science_text_primary"
                android:textColorHint="@color/science_text_secondary" />

            <TextView
                android:id="@+id/tvScienceApiStatus"
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="No API key saved." />

            <ProgressBar
                android:id="@+id/progressScienceApiTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTestScienceApi"
                    style="@style/ScienceSecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Test connection" />

                <Button
                    android:id="@+id/btnSaveScienceSettings"
                    style="@style/SciencePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Save" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClearScienceApi"
                style="@style/ScienceSecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Remove saved API key"
                android:textColor="@color/science_error" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display and accessibility"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/cbScienceAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/science_control_tint"
                android:minHeight="48dp"
                android:text="Use subtle animated background"
                android:textColor="@color/science_text_primary" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Animation pauses automatically in battery saver. Science text, options, radio buttons and checkboxes use high-contrast states and 48dp touch targets." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPeriodicBack"
            style="@style/ScienceSecondaryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Back"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="‹"
            android:textSize="28sp" />

        <TextView
            style="@style/ScienceHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Periodic table" />
    </LinearLayout>

    <EditText
        android:id="@+id/etElementSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/science_field_background"
        android:hint="Search by name, symbol, number or category"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/science_text_primary"
        android:textColorHint="@color/science_text_secondary" />

    <Button
        android:id="@+id/btnElementSearch"
        style="@style/SciencePrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Search elements" />

    <TextView
        android:id="@+id/tvElementCount"
        style="@style/ScienceSecondaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeriodicTable"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background">

    <com.example.aimentor.science.presentation.view.ScienceAnimatedBackgroundView
        android:id="@+id/scienceAnimatedBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutScienceHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/science_glass_header"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnScienceBack"
            style="@style/ScienceSecondaryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Back"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="‹"
            android:textColor="@color/science_text_primary"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Science AI Mentor" />

            <TextView
                android:id="@+id/tvChatSubjectStatus"
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Physics · Middle school · Step by step" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNewScienceChat"
            style="@style/ScienceSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:text="New" />

        <Button
            android:id="@+id/btnChatTools"
            style="@style/ScienceSecondaryButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Science tools and settings"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="⋮"
            android:textColor="@color/science_text_primary"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelChatTools"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/science_glass_header"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutScienceHeader">

        <TextView
            style="@style/ScienceSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose one subject tutor. Each tutor keeps a separate conversation and teaching prompt." />

        <RadioGroup
            android:id="@+id/rgScienceSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPhysics"
                style="@style/ScienceSubjectRadio"
                android:checked="true"
                android:text="Physics" />

            <RadioButton
                android:id="@+id/rbChemistry"
                style="@style/ScienceSubjectRadio"
                android:text="Chemistry" />

            <RadioButton
                android:id="@+id/rbBiology"
                style="@style/ScienceSubjectRadio"
                android:text="Biology" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ScienceSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Education level" />

                <Spinner
                    android:id="@+id/spEducationLevel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="Education level" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ScienceSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explanation style" />

                <Spinner
                    android:id="@+id/spExplanationStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:contentDescription="Explanation style" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnScienceHistory"
                    style="@style/ChatToolButton"
                    android:text="History" />

                <Button
                    android:id="@+id/btnScienceBookmarks"
                    style="@style/ChatToolButton"
                    android:text="Bookmarks" />

                <Button
                    android:id="@+id/btnScienceQuiz"
                    style="@style/ChatToolButton"
                    android:text="Adaptive quiz" />

                <Button
                    android:id="@+id/btnSciencePlanner"
                    style="@style/ChatToolButton"
                    android:text="AI study plan" />

                <Button
                    android:id="@+id/btnPeriodicTable"
                    style="@style/ChatToolButton"
                    android:text="Periodic table" />

                <Button
                    android:id="@+id/btnCircuitDiagram"
                    style="@style/ChatToolButton"
                    android:text="Circuit" />

                <Button
                    android:id="@+id/btnScienceProgress"
                    style="@style/ChatToolButton"
                    android:text="Progress" />

                <Button
                    android:id="@+id/btnScienceApiSettings"
                    style="@style/ChatToolButton"
                    android:text="Settings" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutChatContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutChatComposer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/panelChatTools">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScienceChat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="20dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/layoutChatEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/science_chat_avatar_background"
                android:gravity="center"
                android:text="AI"
                android:textColor="@color/science_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="What would you like to learn?"
                android:textSize="22sp" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Ask by text or attach a homework image. Switch tutor in the tools panel."
                android:textAlignment="center" />

            <Button
                android:id="@+id/btnSuggestionPhenomenon"
                style="@style/ChatSuggestionButton"
                android:layout_marginTop="18dp"
                android:text="Why does the sky look blue?" />

            <Button
                android:id="@+id/btnSuggestionChemistry"
                style="@style/ChatSuggestionButton"
                android:text="Balance: H₂ + O₂ → H₂O" />

            <Button
                android:id="@+id/btnSuggestionBiology"
                style="@style/ChatSuggestionButton"
                android:text="How does photosynthesis work?" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutChatComposer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/science_glass_composer"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/layoutSelectedImage"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="52dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/science_chat_image_preview_background"
            android:padding="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSciencePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Selected homework image"
                android:scaleType="centerCrop" />

            <Button
                android:id="@+id/btnClearImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:background="@drawable/science_chat_remove_image_background"
                android:contentDescription="Remove selected image"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:text="×"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/science_chat_composer_background"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:padding="5dp">

            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Choose homework image"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:text="＋"
                android:textColor="@color/science_text_primary"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Take a homework photo"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:text="📷"
                android:textColor="@color/science_text_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etScienceQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="Message the selected Science tutor"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:textColor="@color/science_text_primary"
                android:textColorHint="@color/science_text_secondary"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnAskScience"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/science_chat_send_background"
                android:contentDescription="Send message"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                android:text="↑"
                android:textColor="@color/science_on_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/ScienceSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="5dp"
            android:text="AI can make mistakes. Verify important formulas, health information and experiment safety."
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuizBack"
                style="@style/ScienceSecondaryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:minWidth="48dp"
                android:padding="0dp"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Adaptive Science quiz" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject" />

            <Spinner
                android:id="@+id/spQuizSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Quiz subject" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Education level" />

            <Spinner
                android:id="@+id/spQuizLevel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Quiz education level" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Topic" />

            <EditText
                android:id="@+id/etQuizTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/science_field_background"
                android:hint="Examples: energy, acids and bases, cells"
                android:inputType="textCapSentences"
                android:minHeight="52dp"
                android:textColor="@color/science_text_primary"
                android:textColorHint="@color/science_text_secondary" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Number of questions" />

            <Spinner
                android:id="@+id/spQuizCount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Number of quiz questions" />

            <TextView
                android:id="@+id/tvQuizAdaptiveStatus"
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/science_panel"
                android:padding="12dp"
                android:text="Each quiz adapts to the selected education level and recent results, while avoiding recent questions."
                android:accessibilityLiveRegion="polite" />

            <Button
                android:id="@+id/btnGenerateQuiz"
                style="@style/SciencePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Generate new adaptive quiz" />

            <ProgressBar
                android:id="@+id/progressQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSubmitQuiz"
            style="@style/SciencePrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Submit quiz"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvQuizResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:gravity="center"
            android:padding="14dp"
            android:textColor="@color/science_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive" />
    </LinearLayout>
</ScrollView>

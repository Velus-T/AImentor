<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStudyPlannerBack"
                style="@style/ScienceSecondaryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:minWidth="48dp"
                android:padding="0dp"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="AI Science study plan" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/science_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The first study session starts at the exact moment you press Generate. Later sessions continue daily at the same clock time." />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Subject" />

            <Spinner
                android:id="@+id/spPlannerSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Science subject" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Education level" />

            <Spinner
                android:id="@+id/spPlannerLevel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:contentDescription="Education level" />

            <TextView
                style="@style/ScienceSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Learning goal" />

            <EditText
                android:id="@+id/etPlannerGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/science_field_background"
                android:hint="Example: prepare for the final exam on electricity"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="64dp"
                android:textColor="@color/science_text_primary"
                android:textColorHint="@color/science_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ScienceSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan length" />

                    <Spinner
                        android:id="@+id/spPlannerDays"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="Number of study days" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ScienceSecondaryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily time" />

                    <Spinner
                        android:id="@+id/spPlannerMinutes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:contentDescription="Minutes per study day" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnGenerateStudyPlan"
                style="@style/SciencePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Generate plan from now" />

            <ProgressBar
                android:id="@+id/progressStudyPlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStudyPlanStatus"
            style="@style/ScienceSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:padding="14dp"
            android:text="No study plan has been generated yet."
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/layoutStudySessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnClearStudyPlan"
            style="@style/ScienceSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="Clear saved study plan"
            android:textColor="@color/science_error"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

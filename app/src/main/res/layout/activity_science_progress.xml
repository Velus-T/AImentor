<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnProgressBack"
                style="@style/ScienceSecondaryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:minWidth="48dp"
                android:padding="0dp"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Science progress" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTotalQuestions"
            style="@style/ScienceStatCard"
            android:layout_marginTop="16dp" />
        <TextView android:id="@+id/tvMostStudied" style="@style/ScienceStatCard" />
        <TextView android:id="@+id/tvBookmarkCount" style="@style/ScienceStatCard" />
        <TextView android:id="@+id/tvQuizAccuracy" style="@style/ScienceStatCard" />
        <TextView android:id="@+id/tvReviewTime" style="@style/ScienceStatCard" />

        <TextView
            android:id="@+id/tvProgressInsight"
            style="@style/ScienceBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:lineSpacingExtra="4dp"
            android:padding="16dp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/science_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCircuitBack"
                style="@style/ScienceSecondaryButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Back"
                android:minWidth="48dp"
                android:padding="0dp"
                android:text="‹"
                android:textSize="28sp" />

            <TextView
                style="@style/ScienceHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Physics circuit diagram" />
        </LinearLayout>

        <TextView
            style="@style/ScienceSecondaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Circuit type" />

        <Spinner
            android:id="@+id/spCircuitType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/science_field_background"
            android:contentDescription="Circuit type"
            android:paddingStart="10dp"
            android:paddingEnd="8dp" />

        <CheckBox
            android:id="@+id/cbCircuitSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/science_control_tint"
            android:checked="true"
            android:minHeight="48dp"
            android:text="Switch closed (current can flow)"
            android:textColor="@color/science_text_primary" />

        <com.example.aimentor.science.presentation.view.CircuitDiagramView
            android:id="@+id/circuitDiagramView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:contentDescription="Interactive series or parallel circuit diagram" />

        <TextView
            android:id="@+id/tvCircuitExplanation"
            style="@style/ScienceBodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/science_panel"
            android:lineSpacingExtra="4dp"
            android:padding="14dp" />
    </LinearLayout>
</ScrollView>

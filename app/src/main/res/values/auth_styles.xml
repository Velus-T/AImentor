<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AuthInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/ui_surface</item>
        <item name="boxStrokeColor">@color/auth_input_stroke</item>
        <item name="hintTextColor">@color/ui_primary</item>
        <item name="android:textColorHint">@color/ui_muted</item>
        <item name="endIconTint">@color/ui_muted</item>
    </style>
    <style name="AuthEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="AuthTitle" parent="UiTitle">
        <item name="android:textSize">30sp</item>
        <item name="android:layout_marginTop">28dp</item>
    </style>
    <style name="AuthCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@drawable/ui_card</item>
    </style>
</resources>

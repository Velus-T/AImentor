<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="UiTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="UiBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="UiField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textColorHint">@color/ui_muted</item>
        <item name="android:background">@drawable/ui_field</item>
    </style>
    <style name="UiButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_on_primary</item>
        <item name="backgroundTint">@color/ui_primary</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="UiLink" parent="UiBody">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ui_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIMentor.Science" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/science_primary</item>
        <item name="colorOnPrimary">@color/science_on_primary</item>
        <item name="colorPrimaryContainer">@color/science_primary_container</item>
        <item name="colorSurface">@color/science_surface</item>
        <item name="colorOnSurface">@color/science_text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/science_surface</item>
        <item name="android:statusBarColor">@color/science_surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ScienceHeaderTitle">
        <item name="android:textColor">@color/science_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScienceBodyText">
        <item name="android:textColor">@color/science_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ScienceSecondaryText">
        <item name="android:textColor">@color/science_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SciencePrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/science_on_primary</item>
        <item name="backgroundTint">@color/science_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScienceSecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/science_primary_dark</item>
        <item name="strokeColor">@color/science_border</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ChatToolButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:textColor">@color/science_text_primary</item>
        <item name="strokeColor">@color/science_border</item>
        <item name="backgroundTint">@color/science_surface</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ChatSuggestionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/science_text_primary</item>
        <item name="strokeColor">@color/science_border</item>
        <item name="backgroundTint">@color/science_surface</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="ScienceStatCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/science_panel</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/science_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ScienceSubjectRadio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/science_option_background</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/science_option_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ChatMessageActionButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/science_primary_dark</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
